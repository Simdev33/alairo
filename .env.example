# Másold .env.local néven (valódi kulcsot soha ne commitolj). Vercelen: Settings → Environment Variables.

# Stripe — teszt-kulcsok: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Opcionális: meglévő Price ID-k. Üresen az alkalmazás egyszer létrehozza (és utána újrahasználja)
# a DoneSignIn árait: 2,99 € egyszeri díj a 7 napos időszakra, 9,90 €/hó előfizetés.
STRIPE_PRICE_TRIAL=
STRIPE_PRICE_MONTHLY=

# A belépési sütiket írja alá. Bármilyen hosszú véletlen szöveg (pl. `openssl rand -hex 32`).
SESSION_SECRET=

# Belépési kódok e-mailben a https://resend.com-on keresztül. Kulcs nélkül a kód a szervernaplóba kerül
# (csak fejlesztéshez — élesben kulcs nélkül a kódos belépés nem működik).
RESEND_API_KEY=
EMAIL_FROM="DoneSignIn <no-reply@donesignin.com>"

# Az élő oldal címe (Stripe-portál linkjei, hreflang). Vercelen élesben alapból https://donesignin.com.
NEXT_PUBLIC_SITE_URL=

# Upstash Redis (Vercel Storage → Upstash for Redis, „KV” előtaggal) — Vercelen kötelező.
KV_REST_API_URL=
KV_REST_API_TOKEN=
